# Browser requests use the current origin in development and production.
VITE_API_ROOT=/miniagent/api/v1
# Existing Docker deployment exposes its API through Nginx, not host port 8066.
MINIAGENT_PROXY_TARGET=http://127.0.0.1:18080
# For a backend launched directly with Java, use http://127.0.0.1:8066 instead.
