MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USERNAME=miniagent
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB_NAME=ai-agent
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true

POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=miniagent
POSTGRESQL_PASSWORD=your_postgresql_password
POSTGRESQL_DB_NAME=ai-agent

REDIS_HOST=localhost
REDIS_PORT=16380
REDIS_DATABASE=0
REDIS_PASSWORD=your_redis_password

OPENAI_BASE_URL=http://localhost:3000
OPENAI_API_KEY=sk-replace-with-api-key

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SCHEMA_NAME=public
EMBEDDING_TABLE_NAME=vector_store_openai

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=miniagent
RABBITMQ_PASSWORD=your_rabbitmq_password

SYSTEM_MODEL_BASE_URL=http://localhost:3000
SYSTEM_MODEL_API_KEY=sk-replace-with-api-key
SYSTEM_MODEL_NAME=replace-with-your-chat-model

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=miniagent

OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-with-your-bucket
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
