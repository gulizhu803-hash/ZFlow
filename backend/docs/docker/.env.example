# Avoid USERNAME: Windows supplies that environment variable before Compose reads .env.
MINIAGENT_USER=miniagent
PASSWORD=your_password
TZ=Asia/Shanghai

# Host ports. Keep these in sync with backend/.env when running Java on the host.
MYSQL_PORT=13306
POSTGRESQL_PORT=5432
REDIS_PORT=16380
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ONEAPI_PORT=3000
WEB_PORT=18080

# Generate your own random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional integrations; without real credentials, login/UI work but AI/OSS calls do not.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=not-configured
SYSTEM_MODEL_BASE_URL=https://api.openai.com
SYSTEM_MODEL_API_KEY=not-configured
SYSTEM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-v4
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=not-configured
OSS_ACCESS_KEY_ID=not-configured
OSS_ACCESS_KEY_SECRET=not-configured
